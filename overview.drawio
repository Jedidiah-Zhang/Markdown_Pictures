<mxCell id="b45" value="系统归属：ParStock → Régens（Ghibli 使用）｜ Client API · Tracker · CMS → CECZ·Vác（Levelwise 开发）｜ 智能仓（Wayzim WMS / WCS / RCS）→ Wayzim ｜ Octopus 8 → CECZ·Vác（厂商 ✗ 待补）｜ GiTa → Ghibli（外包商维护 · 待替代）｜ Google → Google&lt;br&gt;权威源速查：MRN / e-Vám / 决定书 / 税额 ← NAV（经 Gemeric 流转）｜ 箱 / 袋 / 托 / 车次 ← ParStock ｜ 订单 / 库存 / SKU / 面单 ← Client API（智能仓）｜ 航班 / 运输 / 邮件单据 ← Tracker ｜ 邮件 = 一手事件源&lt;br&gt;待确认 ✗：ParStock 的 vám jelleg 整理人 ｜ Portal 登记信息来源 ｜ Régens → Client API 数据归属 ｜ 10.12 后 B2B 文件来源（详见项目文档）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12.5;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1950" width="2920" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg-② BUD 航空线 · 阶段流程" name="② BUD 航空线 · 阶段流程"><mxGraphModel dx="2200" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3060" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b2" value="一票提单的旅程（SHEIN / TEMU · BUD 航空进口）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=20;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2980" height="40" as="geometry"/></mxCell>
<mxCell id="b3" value="箭头 ＝ 阶段先后 ｜ 每格：事件 / 系统 / 数据 / 方式 ｜ ✅ 已核实 ｜ ◐ 部分确认（详见总图脚注）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="2980" height="30" as="geometry"/></mxCell>
<mxCell id="b4" value="&lt;b&gt;M1 预告到达&lt;/b&gt;&lt;br&gt;系统：公共邮箱（Cainiao / 4PX / TEMU）&lt;br&gt;数据：MAWB · 清单（manifest）· 下载链接&lt;br&gt;方式：邮件（人工阅读）　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="520" height="190" as="geometry"/></mxCell>
<mxCell id="b5" value="&lt;b&gt;M2 入库登记&lt;/b&gt;&lt;br&gt;系统：ParStock Portal（Ghibli 管理岗）&lt;br&gt;数据：入库单（MAWB / 航班 / 件重 / 到货通知）&lt;br&gt;方式：人工登记（来源 ◐）　◐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="580" y="180" width="520" height="190" as="geometry"/></mxCell>
<mxCell id="b6" value="&lt;b&gt;M3 航班到达 / 装板&lt;/b&gt;&lt;br&gt;系统：航司 / 地服（Menzies·AS·Celebi）&lt;br&gt;数据：实际到达 · 装板 / BUP 清单&lt;br&gt;方式：邮件 + 系统　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1120" y="180" width="520" height="190" as="geometry"/></mxCell>
<mxCell id="b7" value="&lt;b&gt;M4 收货 / 码垛（RF）&lt;/b&gt;&lt;br&gt;系统：ParStock APP&lt;br&gt;数据：箱级 Beérkezett · 托盘号 · vám jelleg&lt;br&gt;方式：扫码作业　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1660" y="180" width="520" height="190" as="geometry"/></mxCell>
<mxCell id="b8" value="&lt;b&gt;M5 查验（szemle）&lt;/b&gt;&lt;br&gt;系统：Gemeric / NAV 清单 + ParStock 移库&lt;br&gt;数据：szemle 清单 · e-Vám azonosító · 包裹换箱&lt;br&gt;方式：人工协调　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2200" y="180" width="520" height="190" as="geometry"/></mxCell>
<mxCell id="b9" value="&lt;b&gt;M6 申报 / 放行&lt;/b&gt;&lt;br&gt;系统：NAV（经 Gemeric 处理）&lt;br&gt;数据：MRN · 放行（átengedte）· határozat · 税额&lt;br&gt;方式：申报系统（通道 ◐）　◐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="520" height="190" as="geometry"/></mxCell>
<mxCell id="b10" value="&lt;b&gt;M7 清关完成邮件&lt;/b&gt;&lt;br&gt;系统：公共邮箱（Ghibli 清关组）&lt;br&gt;数据：határozat / e-vám igazolás 附件 · 放行通知&lt;br&gt;方式：人工分发（模板固定）　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="580" y="500" width="520" height="190" as="geometry"/></mxCell>
