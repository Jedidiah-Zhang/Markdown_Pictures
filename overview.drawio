<mxCell id="b4" value="N1 订单接收&#10;系统：JD 平台（iFOP / DC / ighub）&#10;数据：PI / SO 号 · Crossdock 清单 · 导出&#10;方式：人工下载　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="500" height="400" as="geometry"/></mxCell>
<mxCell id="b5" value="N2 订单录入&#10;系统：Client API（文件上传 / SKU / 库存）&#10;数据：入库订单 · SKU 主数据 · 库存上传&#10;方式：文件导入　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="570" y="180" width="500" height="400" as="geometry"/></mxCell>
<mxCell id="b6" value="N3 到货&#10;系统：Container Manager · Site-Manager&#10;数据：班列 / 集装箱到达 · 门岗（车牌）· 预约&#10;方式：人工登记　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1100" y="180" width="500" height="400" as="geometry"/></mxCell>
<mxCell id="b7" value="N4 收货（RF）&#10;系统：Octopus 8（虚拟托）／ IWMS（JD）&#10;数据：收货单 · 逐件扫描 · 差异记录&#10;方式：扫码作业　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1630" y="180" width="500" height="400" as="geometry"/></mxCell>
<mxCell id="b8" value="N5 上架&#10;系统：Octopus →（API 消息）→ Wayzim WMS&#10;数据：库位分配 · AGV / 堆垛机任务&#10;方式：系统对接　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2160" y="180" width="500" height="400" as="geometry"/></mxCell>
<mxCell id="b9" value="N6 存储 / 库存&#10;系统：Wayzim（库存 / 补货）· Client API（视图）&#10;数据：库位 · 库存 · 补货 · 空箱&#10;方式：系统 + 系统　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="500" height="400" as="geometry"/></mxCell>
<mxCell id="b10" value="N7 出库订单&#10;系统：Client API / ERP 推送 → Wayzim（或 IWMS）&#10;数据：出库任务 · 批次 / 效期 · 拣选位&#10;方式：系统　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="570" y="650" width="500" height="400" as="geometry"/></mxCell>
<mxCell id="b11" value="N8 拣选 / 打包&#10;系统：Wayzim PDA / PTL（Stock）｜ IWMS（JD 线）&#10;数据：拣选明细 · recheck · 装箱 · 耗材&#10;方式：扫码作业　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1100" y="650" width="500" height="400" as="geometry"/></mxCell>
<mxCell id="b12" value="N9 交接发运&#10;系统：IWMS handover · 快递（GLS 等）&#10;数据：面单 · 手工交接 · POD&#10;方式：系统 + 人工　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1630" y="650" width="500" height="400" as="geometry"/></mxCell>
