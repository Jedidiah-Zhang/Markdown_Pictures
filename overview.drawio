<mxCell id="b4" value="&lt;b&gt;N1 订单接收&lt;/b&gt;&lt;br&gt;系统：JD 平台（iFOP / DC / ighub）&lt;br&gt;数据：PI / SO 号 · Crossdock 清单 · 导出&lt;br&gt;方式：人工下载　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="520" height="190" as="geometry"/></mxCell>
<mxCell id="b5" value="&lt;b&gt;N2 订单录入&lt;/b&gt;&lt;br&gt;系统：Client API（文件上传 / SKU / 库存）&lt;br&gt;数据：入库订单 · SKU 主数据 · 库存上传&lt;br&gt;方式：文件导入　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="580" y="180" width="520" height="190" as="geometry"/></mxCell>
<mxCell id="b6" value="&lt;b&gt;N3 到货&lt;/b&gt;&lt;br&gt;系统：Container Manager · Site-Manager&lt;br&gt;数据：班列 / 集装箱到达 · 门岗（车牌）· 预约&lt;br&gt;方式：人工登记　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1120" y="180" width="520" height="190" as="geometry"/></mxCell>
