<mxCell id="b8" value="&lt;b&gt;N5 上架&lt;/b&gt;&lt;br&gt;系统：Octopus →（API 消息）→ Wayzim WMS&lt;br&gt;数据：库位分配 · AGV / 堆垛机任务&lt;br&gt;方式：系统对接　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2200" y="180" width="520" height="190" as="geometry"/></mxCell>
<mxCell id="b9" value="&lt;b&gt;N6 存储 / 库存&lt;/b&gt;&lt;br&gt;系统：Wayzim（库存 / 补货）· Client API（视图）&lt;br&gt;数据：库位 · 库存 · 补货 · 空箱&lt;br&gt;方式：系统 + 系统　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="520" height="190" as="geometry"/></mxCell>
<mxCell id="b10" value="&lt;b&gt;N7 出库订单&lt;/b&gt;&lt;br&gt;系统：Client API / ERP 推送 → Wayzim（或 IWMS）&lt;br&gt;数据：出库任务 · 批次 / 效期 · 拣选位&lt;br&gt;方式：系统　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="580" y="500" width="520" height="190" as="geometry"/></mxCell>
