<mxCell id="b4" value="M1 预告到达&#10;系统：公共邮箱（Cainiao / 4PX / TEMU）&#10;数据：MAWB · 清单（manifest）· 下载链接&#10;方式：邮件（人工阅读）　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="500" height="400" as="geometry"/></mxCell>
<mxCell id="b5" value="M2 入库登记&#10;系统：ParStock Portal（Ghibli 管理岗）&#10;数据：入库单（MAWB / 航班 / 件重 / 到货通知）&#10;方式：人工登记（来源 ◐）　◐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="570" y="180" width="500" height="400" as="geometry"/></mxCell>
<mxCell id="b6" value="M3 航班到达 / 装板&#10;系统：航司 / 地服（Menzies·AS·Celebi）&#10;数据：实际到达 · 装板 / BUP 清单&#10;方式：邮件 + 系统　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1100" y="180" width="500" height="400" as="geometry"/></mxCell>
<mxCell id="b7" value="M4 收货 / 码垛&#10;系统：ParStock APP（RF 扫码）&#10;数据：箱级 Beérkezett · 托盘号 · vám jelleg&#10;方式：扫码作业　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1630" y="180" width="500" height="400" as="geometry"/></mxCell>
<mxCell id="b8" value="M5 查验（szemle）&#10;系统：Gemeric / NAV 清单 + ParStock 移库&#10;数据：szemle 清单 · e-Vám azonosító · 包裹换箱&#10;方式：人工协调　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2160" y="180" width="500" height="400" as="geometry"/></mxCell>
<mxCell id="b9" value="M6 申报 / 放行&#10;系统：NAV（经 Gemeric 处理）&#10;数据：MRN · 放行（átengedte）· határozat · 税额&#10;方式：申报系统（通道 ◐）　◐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="500" height="400" as="geometry"/></mxCell>
<mxCell id="b10" value="M7 清关完成邮件&#10;系统：公共邮箱（Ghibli 清关组）&#10;数据：határozat / e-vám igazolás 附件 · 放行通知&#10;方式：人工分发（模板固定）　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="570" y="650" width="500" height="400" as="geometry"/></mxCell>
<mxCell id="b11" value="M8 台账归档&#10;系统：07 自动化 → Google Drive + Excel&#10;数据：决定书号 · 关税 / VAT · 银行日期 · 文件副本&#10;方式：自动化（测试中）　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1100" y="650" width="500" height="400" as="geometry"/></mxCell>
<mxCell id="b12" value="M9 拣货 / 装车&#10;系统：ParStock Portal（车次）→ APP（托盘放行）&#10;数据：Kiadható 托盘 · 装载清单（rakodási lista）&#10;方式：扫码 + 排程　✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1630" y="650" width="500" height="400" as="geometry"/></mxCell>
